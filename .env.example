# Gantry Development Environment
# Copy to .env and adjust as needed

# PostgreSQL
GANTRY_DB_HOST=localhost
GANTRY_DB_PORT=5432
GANTRY_DB_USER=gantry
GANTRY_DB_PASSWORD=gantry_dev
GANTRY_DB_NAME=gantry

# S3/MinIO
GANTRY_S3_ENDPOINT=http://localhost:9000
GANTRY_S3_ACCESS_KEY=gantry
GANTRY_S3_SECRET_KEY=gantry_dev_secret
GANTRY_S3_REGION=us-east-1
GANTRY_S3_USE_PATH_STYLE=true

# Control Plane
GANTRY_HTTP_PORT=8080
GANTRY_GRPC_PORT=8081
GANTRY_LOG_LEVEL=debug
# The Phase 0 lifecycle probe is development-only and disabled unless true.
GANTRY_DEVELOPMENT_MODE=false
GANTRY_PHASE0_DEV_API_TOKEN=
# Enable the protected Copilot API only when both fields are configured.
GANTRY_COPILOT_OIDC_ISSUER=
GANTRY_COPILOT_OIDC_AUDIENCE=gantry-copilot-api
# Set all three for production runner mTLS. Leave unset for local h2c smoke tests.
GANTRY_RUNNER_SERVER_CERT_FILE=
GANTRY_RUNNER_SERVER_KEY_FILE=
GANTRY_RUNNER_CLIENT_CA_FILE=

# Runner
GANTRY_CONTROL_PLANE_ADDR=http://localhost:8081
GANTRY_RUNNER_ID=dev-runner-01
GANTRY_RUNNER_CA_FILE=
GANTRY_RUNNER_CERT_FILE=
GANTRY_RUNNER_KEY_FILE=
