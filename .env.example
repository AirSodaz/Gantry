# Gantry Development Environment
# Copy to .env for manually started services, or .env.local for
# moon run deploy-local:runner-smoke.

# PostgreSQL
GANTRY_DB_HOST=localhost
GANTRY_DB_PORT=5432
GANTRY_DB_USER=gantry
GANTRY_DB_PASSWORD=gantry_dev
GANTRY_DB_NAME=gantry

# S3/MinIO
GANTRY_S3_ENDPOINT=http://localhost:9000
GANTRY_S3_ACCESS_KEY=gantry
GANTRY_S3_SECRET_KEY=gantry_dev_secret
GANTRY_S3_REGION=us-east-1
GANTRY_S3_USE_PATH_STYLE=true

# Control Plane
GANTRY_HTTP_PORT=8080
GANTRY_GRPC_PORT=8081
GANTRY_LOG_LEVEL=debug
# The lifecycle probe is development-only and disabled unless true.
# The runner smoke test enables both defaults when they are unset.
GANTRY_DEVELOPMENT_MODE=false
GANTRY_DEVELOPMENT_API_TOKEN=
GANTRY_DEV_CREDENTIAL_FILE=/tmp/gantry-dev-credentials.enc
GANTRY_DEV_CREDENTIAL_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
# Enable the protected Copilot API only when both fields are configured.
GANTRY_COPILOT_OIDC_ISSUER=
GANTRY_COPILOT_OIDC_AUDIENCE=gantry-copilot-api
# Enable the protected Admin API only when both fields are configured.
GANTRY_ADMIN_OIDC_ISSUER=
GANTRY_ADMIN_OIDC_AUDIENCE=gantry-admin-api
# Copilot Vite development client (Dex PKCE).
VITE_COPILOT_OIDC_ISSUER=http://gantry-dex.localhost:5556/dex
VITE_COPILOT_OIDC_CLIENT_ID=gantry-copilot-web
VITE_COPILOT_OIDC_SCOPE=openid profile email audience:server:client_id:gantry-copilot-api
VITE_COPILOT_API_BASE=/api/copilot/v1
# Admin Vite development client (Dex PKCE).
VITE_ADMIN_OIDC_ISSUER=http://gantry-dex.localhost:5556/dex
VITE_ADMIN_OIDC_CLIENT_ID=gantry-admin-web
VITE_ADMIN_OIDC_SCOPE=openid profile email audience:server:client_id:gantry-admin-api
VITE_ADMIN_API_BASE=/api/admin/v1
# Set all three for production runner mTLS. Leave unset for local h2c smoke tests.
GANTRY_RUNNER_SERVER_CERT_FILE=
GANTRY_RUNNER_SERVER_KEY_FILE=
GANTRY_RUNNER_CLIENT_CA_FILE=

# Runner
GANTRY_CONTROL_PLANE_ADDR=http://localhost:8081
GANTRY_RUNNER_ID=dev-runner-01
GANTRY_RUNNER_CA_FILE=
GANTRY_RUNNER_CERT_FILE=
GANTRY_RUNNER_KEY_FILE=
# Direct provider mode is opt-in for runner V1 development only.
GANTRY_ALLOW_DIRECT_MODEL=0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Checkpoints are encrypted only when this key is present; otherwise persistence is rejected.
GANTRY_RUNNER_CHECKPOINT_KEY=
